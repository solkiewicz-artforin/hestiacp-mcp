{
  "name": "hestiacp-mcp",
  "version": "2.0.0",
  "description": "Production MCP server for the HestiaCP REST API",
  "type": "module",
  "bin": {
    "hestiacp-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod 755 dist/cli.js",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "test": "npm run build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run lint && npm run typecheck && npm test",
    "generate:commands": "node scripts/generate-commands.mjs",
    "check:generated": "npm run generate:commands -- --upstream /tmp/hestiacp-upstream && git diff --exit-code -- src/generated/"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "hestiacp",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "undici": "^7.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
